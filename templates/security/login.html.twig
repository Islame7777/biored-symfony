<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

{% block body %}
<nav class="navbar bg-body-tertiary">
  <form class="container-fluid justify-content-start">
    <a href=""class="btn btn-outline-success me-2" type="button">S'inscrire</a>
    <a href=""class="btn btn-outline-success me-2" type="button">Login</a>
  </form>
</nav>
<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow p-4" style="width: 100%; max-width: 400px;">
        <h3 class="text-center mb-4">Authentifier</h3>

        {% if error %}
            <div class="alert alert-danger text-center">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="alert alert-info text-center">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}" class="text-decoration-underline">Logout</a>
            </div>
        {% endif %}

        <form method="post">
            <div class="mb-3">
                <label for="inputEmail" class="form-label">Email</label>
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" placeholder="Enter your email" autocomplete="email" required autofocus>
            </div>
            <div class="mb-3">
                <label for="inputPassword" class="form-label">Mot de passe</label>
                <input type="password" name="password" id="inputPassword" class="form-control" placeholder="Enter your password" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-primary w-100" type="submit" >Connecter</button>
        </form>

        <div class="mt-3 text-center">
            <a href="#" class="text-decoration-none">Mot de passe  oublié?</a>
        </div>
    </div>
</div>
{%endblock%}