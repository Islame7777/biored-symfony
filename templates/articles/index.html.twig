{% extends 'base.html.twig' %}

{% block title %}article index{% endblock %}

{% block body %}


       
    

<div class="ml-64 p-8">
    <header class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-2xl font-bold border-black-100 text-white">Articles</h1>
            <p class="border-black-100 text-white">Bienvenue dans votre espace administrateur</p>
        </div>
        <div class="flex items-center space-x-4">
            <button onclick="toggleAddModal()" class="c px-4 py-2 text-white rounded-lg hover:bg-black-700 transition-all flex items-center space-x-2">
                <i class="fas fa-plus"></i>
                <span>{{ articleId is not null ? 'Modifier articles' : 'Nouveau articles' }}</span>
            </button>

            <div class="relative">
                <img src="{{ asset('image/photoProfil.jpg') }}" alt="Profile" class="rounded-full cursor-pointer">
            </div>
        </div>
    </header>

    <div class="e rounded-xl shadow-sm overflow-hidden">
        <div class="p-6 border-b border-black-100">
            <h2 class="text-xl font-semibold text-black-800">article</h2>
            <p class="text-black-600 text-sm mt-1">Voici vos article</p>
        </div>
        <div class="p-6">
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full" border="4">
                    <thead>
                        <tr class="bg-black-50">
                            <th class="px-6 py-3 text-left text-xs font-medium text-black-500 uppercase tracking-wider">Nom</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-black-500 uppercase tracking-wider">Prix</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-black-500 uppercase tracking-wider">Stock</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-black-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableId" class="divide-y divide-black-100">
                        {% for article in articles %}
                            <tr>
                                <td class="px-6 py-4">{{ article.nom }}</td>
                                <td class="px-6 py-4">{{ article.prix }}</td>
                                <td class="px-6 py-4">{{ article.stock }}</td>
                                <td class="px-6 py-4">
                                    <button class="text-blue-600 hover:underline">
                                        <a href="{{ path('app_articles_index', {'id': article.id}) }}">
                                            <i class="fas fa-edit"></i>
                                        </a>        
                                    </button>
                                    <button>
                                        
                                        {{ include('articles/_delete_form.html.twig') }}
                                    </button>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4">Aucune Articles trouvée.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Formulaire d'ajout/édition -->
{{ form_start(form) }}
<div id="formulaire" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="e rounded-xl shadow-xl w-full max-w-2xl">
            <div class="p-6">
                <!-- Si une catégorie est en cours de modification, le champ hidden sera rempli avec l'ID -->
                <input type="hidden" id="articleId" name="id" value="{{ articleId }}">
                
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-black-700 mb-2">Nom de la Article</label>
                        {{ form_widget(form.nom) }}
                        {{ form_errors(form.nom) }} 
                    </div>
                    <div>
                        <label for="prix" class="block text-sm font-medium text-black-700 mb-2">prix</label>
                        {{ form_widget(form.prix) }}
                        {{ form_errors(form.prix) }}
                    </div>

                    <div class="col-span-2">
                        <label for="stock" class="block text-sm font-medium text-black-700 mb-2">stock</label>
                        {{ form_widget(form.stock) }}
                        {{ form_errors(form.stock) }}
                    </div>
                </div>
            
                <div class="flex justify-end space-x-3 mt-6">
                    <button type="button" onclick="toggleAddModal()" class="px-6 py-2 border border-black-200 rounded-lg hover:bg-black-50">
                        Annuler
                    </button>
                    <button type="submit" class="px-6 py-2 text-white rounded-lg bg-blue-500 hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        {{ articleId is not null ? 'Mettre à jour' : 'Ajouter' }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}

<script>
    function toggleAddModal() {
        const form = document.getElementById('formulaire');
        form.classList.toggle('hidden');
    }
</script>


{% endblock %}



